{
  "expo": {
    "name": "ATS Club",
    "slug": "arqueria-sierras-chicas",
    "scheme": "arqueriasc",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#032845"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "ATS Club",
      "shortName": "ATS Club",
      "themeColor": "#032845",
      "backgroundColor": "#032845",
      "lang": "es-AR"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para tu foto de perfil."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "backgroundColor": "#032845"
  }
}
